{
  "comments": {
    "lineComment": "※",
    "//": "（ ） は両端に空白があるときだけコメント。空白込みで登録する",
    "blockComment": ["（ ", " ）"]
  },
  "brackets": [
    ["「", "」"],
    ["『", "』"],
    ["（", "）"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "「", "close": "」" },
    { "open": "『", "close": "』" },
    { "open": "（", "close": "）" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" }
  ],
  "surroundingPairs": [
    ["「", "」"],
    ["『", "』"],
    ["（", "）"],
    ["(", ")"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "//wordPattern": "分かち書きの区切り以外はすべて単語の一部。既定の単語判定では日本語の単語が切れてしまう",
  "wordPattern": "[^\\s\\u3000,、，。]+",
  "onEnterRules": [
    {
      "//": "`○○とは` `○○は` の次の行は字下げする",
      "beforeText": "(?:とは|は)[\\s\\u3000]*$",
      "action": { "indentAction": "indent" }
    },
    {
      "//": "`。` で定義が終わったら字下げを戻す",
      "beforeText": "。[\\s\\u3000]*$",
      "action": { "indentAction": "outdent" }
    },
    {
      "//": "`ならば` `ここから` の次も字下げする",
      "beforeText": "(?:ならば|でなければ|さもなければ|ここから|回数指定[\\u3041-\\u3096]*)[\\s\\u3000]*$",
      "action": { "indentAction": "indent" }
    }
  ]
}
