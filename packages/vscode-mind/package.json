{
  "name": "vscode-mind",
  "displayName": "Mind (日本語プログラミング言語)",
  "description": "日本語プログラミング言語 Mind の構文ハイライトと Language Server",
  "version": "0.1.1",
  "publisher": "shin3tky",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/shin3tky/MindLS.git"
  },
  "bugs": {
    "url": "https://github.com/shin3tky/MindLS/issues"
  },
  "homepage": "https://github.com/shin3tky/MindLS#readme",
  "keywords": [
    "mind",
    "日本語プログラミング言語",
    "japanese",
    "language server",
    "lsp"
  ],
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "galleryBanner": {
    "color": "#1A1F2E",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc --build",
    "bundle": "node ../../tools/bundle.mts",
    "vscode:prepublish": "node ../../tools/bundle.mts",
    "package": "node -e \"require('node:fs').mkdirSync('../../dist',{recursive:true})\" && vsce package --no-dependencies --out ../../dist/",
    "release": "vsce publish --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "mind",
        "aliases": [
          "Mind",
          "mind"
        ],
        "extensions": [
          ".src",
          ".mnd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mind",
        "scopeName": "source.mind",
        "path": "./syntaxes/mind.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mind.configureWorkspace",
        "title": "Mind: このワークスペースの文字コードと関連付けを設定する",
        "category": "Mind"
      },
      {
        "command": "mind.restartServer",
        "title": "Mind: Language Server を再起動する",
        "category": "Mind"
      }
    ],
    "configuration": {
      "title": "Mind",
      "properties": {
        "mind.distribution": {
          "type": "string",
          "default": "windows-9",
          "enum": [
            "windows-9",
            "linux-8"
          ],
          "enumDescriptions": [
            "Mind 9 for Windows（Shift_JIS）の標準ライブラリ",
            "Mind 8 for Linux（EUC-JP）の標準ライブラリ"
          ],
          "markdownDescription": "使っている Mind の配布物。補完・ホバー・未定義単語の診断に使う標準単語辞書と、`Mind: このワークスペースの文字コードと関連付けを設定する` の既定の文字コードが切り替わる。"
        },
        "mind.library": {
          "type": "string",
          "default": "file",
          "description": "リンクする標準ライブラリ。GUI 編なら guilib。"
        },
        "mind.diagnostics.undefinedWords": {
          "type": "boolean",
          "default": true,
          "description": "定義されていない単語を指摘する。`\"x.src\"を　コンパイル。` でつながるファイルは一緒に見る。取り込み先が 1 つでも見つからないときと、`mind.library` が `file` 以外のときは、語彙を把握しきれないので自動的に黙る。"
        },
        "mind.diagnostics.forwardReferences": {
          "type": "boolean",
          "default": true,
          "description": "定義より前で引用している単語を指摘する。Mind は前方参照できず、`仮定義` が要る。"
        },
        "mind.diagnostics.negativeForms": {
          "type": "boolean",
          "default": true,
          "description": "`表示しない` のような否定形を指摘する。送り仮名は照合前に落ちるので、肯定形と同じ単語になってしまう。"
        },
        "mind.diagnostics.commentParens": {
          "type": "boolean",
          "default": true,
          "description": "コメントのつもりで書かれた `（ … ）` のうち、前後の空白が足りずに単語の一部になっているものを指摘する。"
        },
        "mind.compiler.docker.image": {
          "type": "string",
          "default": "mind-docker:8.0.08",
          "description": "実コンパイラ連携に使う Docker イメージ。https://github.com/shin3tky/Mind-Docker で作る。"
        },
        "mind.compiler.enabled": {
          "type": "boolean",
          "default": false,
          "description": "保存したときに実 Mind コンパイラで検査する。Docker と mind-docker イメージが要る。既定は無効で、自前解析だけで動く。"
        },
        "mind.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Language Server とのやりとりを出力パネル「Mind Language Server」に記録する。拡張の開発時だけ使う。"
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "mind",
        "scopes": {
          "function.defaultLibrary": [
            "support.function.mind"
          ],
          "function.definition": [
            "entity.name.function.mind"
          ],
          "function.static": [
            "entity.name.function.mind"
          ],
          "function": [
            "entity.name.function.mind"
          ],
          "variable.declaration": [
            "variable.other.mind"
          ],
          "variable.readonly": [
            "variable.other.constant.mind"
          ],
          "variable": [
            "variable.other.mind"
          ],
          "property": [
            "variable.other.property.mind"
          ],
          "type": [
            "entity.name.type.mind"
          ],
          "type.defaultLibrary": [
            "support.type.mind"
          ],
          "macro": [
            "keyword.control.directive.mind"
          ],
          "keyword": [
            "keyword.control.mind"
          ],
          "operator": [
            "keyword.operator.mind"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[mind]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  },
  "dependencies": {
    "@mindls/language-server": "*",
    "vscode-languageclient": "^10.1.1"
  },
  "activationEvents": [
    "onLanguage:mind"
  ]
}
