#!/usr/bin/env bash
# Mind コンテナの共通エントリポイント。
# 環境変数の健全性を軽くチェックしてから、渡されたコマンドを実行する。
set -euo pipefail

if [[ ! -x "${MIND_ROOT:-/opt/mind/pmind}/bin/mind" ]]; then
    echo "warning: ${MIND_ROOT:-/opt/mind/pmind}/bin/mind が見つかりません。イメージのビルドに失敗している可能性があります。" >&2
fi

if [[ $# -eq 0 ]]; then
    exec bash
fi

exec "$@"
