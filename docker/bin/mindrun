#!/usr/bin/env bash
#
# mindrun - Mind が生成した実行ファイルを、入出力を UTF-8 に変換しながら実行する
#
#   使い方: mindrun ./hello [引数 ...]
#
# Mind の実行ファイルは EUC-JP で入出力するため、端末（UTF-8）との間で変換する。
# 標準入力が端末の場合は入力側の変換は行わない（対話実行を壊さないため）。

set -uo pipefail

readonly PROG="${0##*/}"

if [[ $# -eq 0 || "${1}" == "-h" || "${1}" == "--help" ]]; then
    echo "使い方: ${PROG} <実行ファイル> [引数 ...]" >&2
    exit $(( $# == 0 ? 1 : 0 ))
fi

target="$1"; shift

if [[ ! -x "${target}" ]]; then
    if [[ -x "./${target}" ]]; then
        target="./${target}"
    else
        echo "${PROG}: 実行できません: ${target}" >&2
        exit 1
    fi
fi

set -o pipefail

if [[ -t 0 ]]; then
    "${target}" "$@" 2> >(iconv -f EUC-JP -t UTF-8 -c >&2) | iconv -f EUC-JP -t UTF-8 -c
    status="${PIPESTATUS[0]}"
else
    iconv -f UTF-8 -t EUC-JP -c \
        | { "${target}" "$@" 2> >(iconv -f EUC-JP -t UTF-8 -c >&2); echo "${?}" > /tmp/.mindrun.$$ ; } \
        | iconv -f EUC-JP -t UTF-8 -c
    status="$(cat /tmp/.mindrun.$$ 2>/dev/null || echo 1)"
    rm -f "/tmp/.mindrun.$$"
fi

exit "${status:-0}"
